{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signal",
  "main": "src/index.js",

  // 2025-04-01 or later matters for two reasons: it turns on
  // nodejs_compat_populate_process_env (so process.env carries the secrets the
  // copied handlers read), and it is the baseline the current Static Assets
  // behaviour is defined against. Do not lower it without reading src/index.js.
  "compatibility_date": "2026-05-01",

  // node:crypto is used by _db.js (timingSafeEqual, createHmac) and
  // subscribe.js (createHash), and Buffer by both. All three are provided by
  // nodejs_compat; without the flag the Worker fails to start, not at runtime.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs FIRST and falls through to assets, which is what lets
    // /api/* be claimed before a static file of the same name could shadow it.
    "run_worker_first": ["/api/*"],
    // EVERY ROUTE IS A REAL PATH NOW, so the server has to answer for paths it
    // has no file for. /markets, /screen, /signals and /stock/RELIANCE all
    // return index.html and the router takes it from there.
    //
    // This is what makes per-route metadata possible at all: a fragment is
    // never sent to the server, so under hash routing every page shared the
    // homepage's title, description, canonical and Open Graph card. A link to
    // the ledger unfurled in a chat as the front page.
    "not_found_handling": "single-page-application"
  },

  // ── THE PIPELINE WATCHDOG ────────────────────────────────────────────────
  // Every 20 minutes. GitHub Actions' own scheduler drops runs — on the
  // morning this was added it had skipped daily_scan's 05:00 slot AND both of
  // its retries, so the signals and Telegram alerts for the day never fired.
  // src/watchdog.js compares what ran against what should have and dispatches
  // only the difference; on a healthy day it does nothing at all.
  "triggers": { "crons": ["*/20 * * * *"] },

  "observability": { "enabled": true },

  // CUSTOM DOMAIN — uncomment once DNS for the hostname is in this Cloudflare
  // account, then `wrangler deploy`. Cloudflare provisions the certificate and
  // the route itself; there is no A or CNAME record to add by hand for a
  // Workers custom domain, which is the step people add and then wonder why it
  // conflicts.
  //
  // Do this BEFORE `npm run set-domain <host>` — that flips the page to
  // index,follow and writes a canonical, and a canonical pointing at a
  // hostname that does not resolve is a dead end a crawler holds against you.
  //
  "routes": [{ "pattern": "signal.askakshay.com", "custom_domain": true }],

  // Declaring a route turns workers.dev OFF by default. Kept ON deliberately:
  // signal.askakshay.workers.dev stays useful as a staging URL to check a
  // deploy before pointing anyone at the real domain. It is not an SEO problem
  // once set-domain has run — the canonical tag on every page names
  // signal.askakshay.com, which is precisely what canonical is for.
  "workers_dev": true,

  // NO secrets here. TURSO_URL and TURSO_TOKEN are set with
  // `wrangler secret put`, which stores them encrypted and keeps them out of
  // git. See README.md.
  "vars": {
    "SITE": "signal"
  }
}
